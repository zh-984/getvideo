# GetVideo 配置模板
# 复制此文件为 .env 并填入你的真实值
# cp .env.example .env

# 服务端口
PORT=3000

# 服务器公网地址（用于生成代理 URL，如 video.example.com:8000 或 https://video.example.com）
# 留空则自动从请求 Header（Host / X-Forwarded-Proto）获取
# SERVER_HOST=

# 允许的来源（CORS），逗号分隔；留空或 * 则允许所有来源
# CORS_ORIGIN=*

# 热重载规则接口 (/api/rules/reload) 的公网访问密钥（本机回环无需密钥）
# ADMIN_TOKEN=change-me-to-a-random-string
